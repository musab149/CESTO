# Local dev default. Override for staging/prod.
#
# IMPORTANT: If running Expo Go on a physical device, localhost will NOT work.
# Use your machine's LAN IP instead, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
# Find your LAN IP with `ipconfig` (Windows) or `ifconfig` (mac/linux).
# In development a private/localhost host is rewritten to whichever machine is
# serving the bundle (src/lib/api.ts), so a stale LAN address repairs itself.
#
# To point a dev run at a deployed API instead, use the full hostname — those
# are left exactly as written:
#   staging     EXPO_PUBLIC_API_URL=https://cesto-api-staging-0rpg.onrender.com
#   production  EXPO_PUBLIC_API_URL=https://cesto.onrender.com
# EAS builds do not read this file: the preview and production profiles carry
# their own EXPO_PUBLIC_API_URL in eas.json.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps Geocoding API key — used to reverse-geocode the device's
# expo-location coords into a city/postcode for the home "Delivering to"
# pill. Enable "Geocoding API" on the Google Cloud project, restrict the
# key to Android package `es.cesto.app` + iOS bundle id `es.cesto.app`.
# Without it, the pill falls back to the user's default address or the
# "Set location" CTA.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Google Sign-In (expo-auth-session). Without the WEB client id the button
# renders as a disabled stub — see src/components/GoogleAuthButton.tsx.
# Create the OAuth client ids in the same Google Cloud project as the Maps
# key. Android's client id must be registered against package `es.cesto.app`
# plus the signing certificate SHA-1 of the build you are installing (the EAS
# development/preview builds use a different SHA-1 than a Play-signed build).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
