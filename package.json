{
  "name": "grocery-app-spain",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"npm run api:dev\" \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/admin\"",
    "mobile:dev": "npm run dev --workspace=apps/mobile",
    "db:up": "docker compose up -d",
    "db:setup": "npm run api:migrate && npm run api:seed",
    "api:dev": "npm run dev --workspace=packages/api",
    "api:build": "npm run build --workspace=packages/api",
    "api:migrate": "npm run migrate --workspace=packages/api",
    "api:seed": "npm run seed --workspace=packages/api",

    "kill:port": "node scripts/kill-port.mjs",
    "dev:clean": "node scripts/kill-port.mjs 3000 5173 5174 5199 8081",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "dev:reset": "npm run dev:clean && npm --workspace @grocery-app/api run prisma:generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
