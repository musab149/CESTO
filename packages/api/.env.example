DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocery_app_spain?schema=public"

# Customer auth
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-refresh"

# Admin auth (separate keys so leaking one does not compromise the other)
JWT_ADMIN_SECRET="change-me-admin"
JWT_ADMIN_REFRESH_SECRET="change-me-admin-refresh"

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8081"

# Public web URL — used to compose password-reset links sent to users.
WEB_URL="http://localhost:5199"

# Bunny.net (image uploads + delivery). Leave blank locally: with no Bunny
# config the API stores uploads on local disk under packages/api/uploads/ and
# serves them from /uploads/*, which is enough for dev.
#
# BUNNY_STORAGE_ZONE  storage zone name (first path segment of a storage URL)
# BUNNY_STORAGE_KEY   the storage zone PASSWORD, not the account API key.
#                     Zone-wide read/write/delete — server only, never shipped
#                     to a browser. That is why uploads proxy through the API.
# BUNNY_CDN_URL       pull zone base used to build public URLs
# BUNNY_STORAGE_HOST  region endpoint; omit for Frankfurt (the default).
#                     Others: uk. / ny. / la. / sg. / se. / br. / jh. / syd.
#                     Find it on the storage zone's FTP & API Access page.
#
# The pull zone needs BOTH "Bunny Optimizer" and its automatic WebP/AVIF
# conversion enabled, or images serve at full size in their stored format.
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_KEY=""
BUNNY_CDN_URL=""
BUNNY_STORAGE_HOST=""
# Optional. The storage zone's READ-ONLY password, used by
# `npm run backfill:variants` (no --commit) so a diagnostic never needs a
# key that can write. Both are on Storage -> Access -> API / HTTP.
BUNNY_STORAGE_READONLY_KEY=""

# Google OAuth — the SAME Web Client ID that the web app uses
# (VITE_GOOGLE_CLIENT_ID) and mobile uses (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
# Server needs it as a sentinel; without it POST /api/auth/google returns 503.
# No client secret needed — we verify by hitting Google's userinfo endpoint
# with the token the client sends.
GOOGLE_CLIENT_ID=""

# Sign in with Apple (iOS app). The identity token's audience must be one of
# these bundle ids. Optional — defaults to the iOS bundle id, com.cestoshop.app.
# Comma-separate to accept more than one (e.g. a separate staging app).
# APPLE_BUNDLE_IDS="com.cestoshop.app"

# Sign in with Apple key — revokes a customer's Apple sign-in when they delete
# their account (App Review 5.1.1(v)). Developer account → Keys → the key with
# "Sign in with Apple". Unset: sign-in still works, nothing is revoked.
# Give the key either inline (production: paste the .p8 contents into the
# dashboard) or as a path to the .p8 file (local). Never commit the key.
# APPLE_TEAM_ID="F2WFA7N49L"
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"
# APPLE_PRIVATE_KEY_PATH="/Users/you/Documents/Apple Keys/AuthKey_XXXXXXXXXX.p8"

# Expo push (iOS notifications). Optional — only needed if "enhanced push
# security" is switched on for the project at expo.dev. iOS registers Expo push
# tokens, which the API sends through Expo's push service; Android keeps using
# FCM (FIREBASE_SERVICE_ACCOUNT below).
# EXPO_ACCESS_TOKEN=""

# Google Maps Geocoding — turns a written address into coordinates, which is
# what distance-based delivery pricing measures against. Needed for:
#   · the "Locate" button on admin Settings → Orders (the dispatch origin)
#   · geocoding a customer's delivery address when they save it
#
# This is a SEPARATE key from the web/mobile VITE_GOOGLE_MAPS_KEY. That one is
# restricted by HTTP referrer so it can sit in a browser bundle; this one is a
# server key and should be restricted by IP to the API host instead. Enable
# the "Geocoding API" on it.
#
# Leave blank and nothing breaks: geocoding is skipped, addresses keep no
# coordinates, and delivery falls back to the flat fee everywhere. Distance
# pricing simply has no effect until this is set.
GOOGLE_MAPS_KEY=""

# Firebase Cloud Messaging — JSON of a service-account key from Firebase
# console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE JSON on one line (or escape newlines). Without it, the
# push dispatcher falls back to a console logger (notifications still land
# in the DB inbox, they just don't hit the device).
FIREBASE_SERVICE_ACCOUNT=""

# Web push (browser notifications) — VAPID key pair. Generate once with
# `npx web-push generate-vapid-keys` and reuse across staging/prod (rotating
# invalidates every existing subscription — everyone re-opts-in). VAPID_SUBJECT
# must be a mailto: link or https URL identifying the sender (Google requires it).
# Without these three set, /api/notifications/vapid-public-key returns 503 and
# the web browser push flow is disabled — DB inbox still works.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@cesto.es"

# Resend (transactional email) — leave RESEND_API_KEY blank in dev to fall
# back to the console mailer (logs every send to stdout, no real email).
# In staging/prod: create a key at https://resend.com and paste it here.
RESEND_API_KEY=""
# Sender identity. MUST be on a Resend-verified domain. Format either
# "user@domain.com" or the friendly form 'Cesto <noreply@cestoshop.com>'.
RESEND_FROM=""
# Where user replies to welcome / order / reset emails should land. Leave
# blank to let replies bounce at Resend's postmaster (current behaviour).
# Recommended: soporte@cestoshop.com or your support inbox.
REPLY_TO_EMAIL=""
# Support ticket notification inbox — where customer support tickets are
# forwarded when submitted via /contact or /help. Defaults to RESEND_FROM
# then support.cesto@gmail.com when unset.
SUPPORT_INBOX_EMAIL=""
# Admin URL — used in support-ticket notification emails so the deep link
# to the ticket in the admin panel actually resolves.
ADMIN_URL="http://localhost:5173"
