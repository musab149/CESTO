{
  "name": "@grocery-app/shared",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:image-url": "ts-node -P tsconfig.test.json tests/imageUrl.test.ts",
    "test:spain": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"} src/spain.test.ts",
    "test:tax": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\",\\\"moduleResolution\\\":\\\"node\\\"} src/tax.test.ts",
    "test:service-paths": "ts-node -P tsconfig.test.json tests/servicePaths.test.ts",
    "test:sales-keys": "ts-node -P tsconfig.test.json tests/salesKeys.test.ts",
    "test:business-keys": "ts-node -P tsconfig.test.json tests/businessKeys.test.ts",
    "test:invoice-lock": "ts-node -P tsconfig.test.json tests/invoiceLock.test.ts",
    "test:delivery-fee": "ts-node -P tsconfig.test.json tests/deliveryFee.test.ts",
    "test:factura-pages": "ts-node -P tsconfig.test.json tests/facturaPages.test.ts",
    "test:cart-sync": "ts-node -P tsconfig.test.json tests/cartSync.test.ts",
    "test:connection": "ts-node -P tsconfig.test.json tests/connection.test.ts",
    "test:route-access": "ts-node -P tsconfig.test.json tests/routeAccess.test.ts",
    "test:session-refresh": "ts-node -P tsconfig.test.json tests/sessionRefresh.test.ts",
    "test:product-cache": "ts-node -P tsconfig.test.json tests/productCache.test.ts",
    "test:order-progress": "ts-node -P tsconfig.test.json tests/orderProgress.test.ts",
    "test:rep-ledger": "ts-node -P tsconfig.test.json tests/repLedger.test.ts",
    "test:order-editing": "ts-node -P tsconfig.test.json tests/orderEditing.test.ts",
    "test:saved-basket": "ts-node -P tsconfig.test.json tests/savedBasket.test.ts",
    "test:invoice-line-price": "ts-node -P tsconfig.test.json tests/invoiceLinePrice.test.ts",
    "test:saved-form": "ts-node -P tsconfig.test.json tests/savedForm.test.ts",
    "test:factura-line-bases": "ts-node -P tsconfig.test.json tests/facturaLineBases.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "html2canvas-pro": "^2.3.3",
    "jspdf": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
